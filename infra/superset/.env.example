# Variables propias de Superset (docker compose lee este .env junto al compose.yaml).
# Copiar a infra/superset/.env y reemplazar los valores. Nunca commitear el .env real.
# El resto de variables del producto sigue en el .env.example de la raíz.

# Secretos de la instancia (mínimo 42 caracteres los *_SECRET_KEY).
SUPERSET_SECRET_KEY=change-me-local-with-at-least-42-characters
SUPERSET_DB_PASSWORD=change-me-local
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-local
SUPERSET_ADMIN_EMAIL=admin@local.test
# Cuenta de servicio dedicada para emitir guest tokens (no la del superadmin).
SUPERSET_GUEST_TOKEN_USERNAME=guest-token-service
SUPERSET_GUEST_TOKEN_PASSWORD=change-me-local
SUPERSET_GUEST_TOKEN_JWT_SECRET=change-me-local-with-at-least-42-characters
REFINE_ORIGIN=http://localhost:4300
WEB_PORT=4300

# Red de Supabase (ver docs/operar-superset.md).
SUPABASE_DOCKER_NETWORK=supabase_network_multistorefront-meli-supabase-dev

# Conexión de SOLO LECTURA al esquema `analitica` de la base de la app (FR-008).
# El usuario `superset_analitica` lo crea la migración
# 20261130100300_analitica_rol_superset.sql y solo puede leer `analitica`.
# Host de la base dentro de la red Docker de Supabase y contraseña del rol.
# Sin valor real en Git: se inyectan por entorno al empaquetar e importar.
SUPERSET_ANALITICA_DB_HOST=
SUPERSET_ANALITICA_DB_PASSWORD=
