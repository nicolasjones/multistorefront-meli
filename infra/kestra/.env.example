# Variables propias de Kestra (docker compose lee este .env junto al compose.yaml).
# Copiar a infra/kestra/.env y reemplazar los valores; el resto de variables del
# producto sigue en el .env.example de la raíz. Nunca commitear el .env real.

# Copias de seguridad (épica MSF-457, F-OPS-01). Destino: remoto rclone
# `respaldos` = directorio dedicado del MISMO servidor (decisión 2026-10-17).
# RESPALDOS_DIR_HOST es la carpeta del host (idealmente un disco o punto de
# montaje propio, fuera de los volúmenes de Supabase, permisos 700 y dueño
# root, que es quien corre Kestra y rclone); dentro de los contenedores de copia se ve en
# /respaldos (RESPALDOS_RUTA). Para llevar las copias a S3/B2/SFTP se cambian
# solo estas variables (RESPALDOS_RCLONE_TIPO=s3|b2|sftp + credenciales y
# RESPALDOS_RUTA=bucket/prefijo); los flows no cambian. Ver
# docs/copias-y-restauracion.md. Valores reales solo en infra/kestra/.env.
RESPALDOS_DIR_HOST=/var/lib/automation-platform/respaldos
RESPALDOS_RUTA=/respaldos
RESPALDOS_RCLONE_TIPO=local
# Solo para tipos remotos (s3/b2/sftp); vacías con tipo local.
RESPALDOS_RCLONE_PROVIDER=
RESPALDOS_RCLONE_ENDPOINT=
RESPALDOS_RCLONE_REGION=
RESPALDOS_RCLONE_ACCESS_KEY_ID=
RESPALDOS_RCLONE_SECRET_ACCESS_KEY=
RESPALDOS_RCLONE_HOST=
RESPALDOS_RCLONE_USER=
RESPALDOS_RCLONE_PASS=
# Retención: copias diarias recientes y primera copia de cada mes (FR-003).
RESPALDOS_RETENCION_DIARIAS=30
RESPALDOS_RETENCION_MENSUALES=12
# Tablas (esquema.tabla, separadas por coma) que deben tener datos tras la
# restauración de prueba (FR-004).
RESPALDOS_VERIFICAR_TABLAS=public.respaldos,public.organizaciones
# Endpoint S3 de Supabase Storage y sus claves de acceso S3 (generadas en el
# Storage de Supabase). Origen de la copia de imágenes.
RESPALDOS_STORAGE_ENDPOINT=http://host.docker.internal:9300/storage/v1/s3
RESPALDOS_STORAGE_REGION=local
RESPALDOS_STORAGE_ACCESS_KEY_ID=change-me-local
RESPALDOS_STORAGE_SECRET_ACCESS_KEY=change-me-local
# Aviso de fallos de copia/verificación por correo (FR-005): SMTP genérico,
# el proveedor concreto se elige después. KESTRA_SMTP_TRANSPORTE: SMTP,
# SMTPS o SMTP_TLS.
KESTRA_SMTP_HOST=smtp.example.com
KESTRA_SMTP_PORT=587
KESTRA_SMTP_TRANSPORTE=SMTP_TLS
KESTRA_SMTP_USERNAME=
KESTRA_SMTP_PASSWORD=
KESTRA_SMTP_FROM=copias@example.com
SOPORTE_CORREO=soporte@example.com

# Avisos de consultas (MSF-207, flow avisos-consultas.yml). El flow llama cada minuto a la Edge
# Function `enviar-aviso-consulta`. AVISOS_CONSULTAS_URL: función alcanzable desde el contenedor de
# Kestra. AVISOS_CONSULTAS_APIKEY: clave pública (anon) de Supabase, solo para pasar el gateway.
# SECRET_AVISOS_CONSULTAS_TOKEN: secreto compartido, EN BASE64 (Kestra decodifica los SECRET_*); al
# decodificarlo debe dar el mismo valor que AVISOS_CONSULTAS_TOKEN de los secretos de la función
# (supabase/functions/.env.example). Generarlo: printf '%s' '<token>' | base64 -w0
# El valor de ejemplo es «change-me-local» en base64. Vacío = el flow no autentica.
# Valores reales solo en infra/kestra/.env.
AVISOS_CONSULTAS_URL=http://host.docker.internal:9300/functions/v1/enviar-aviso-consulta
AVISOS_CONSULTAS_APIKEY=change-me-local
SECRET_AVISOS_CONSULTAS_TOKEN=Y2hhbmdlLW1lLWxvY2Fs

# Resumen de reposición de stock (MSF-394, flow avisos-reposicion-stock.yml). El flow llama una vez
# por día a la Edge Function `enviar-resumen-reposicion`. Mismas reglas que los avisos de consultas:
# AVISOS_REPOSICION_URL alcanzable desde el contenedor de Kestra; AVISOS_REPOSICION_APIKEY es la clave
# pública (anon); SECRET_AVISOS_REPOSICION_TOKEN va EN BASE64 y, decodificado, debe coincidir con
# AVISOS_REPOSICION_TOKEN de los secretos de la función. El valor de ejemplo es «change-me-local».
# Valores reales solo en infra/kestra/.env.
AVISOS_REPOSICION_URL=http://host.docker.internal:9300/functions/v1/enviar-resumen-reposicion
AVISOS_REPOSICION_APIKEY=change-me-local
SECRET_AVISOS_REPOSICION_TOKEN=Y2hhbmdlLW1lLWxvY2Fs

# Alertas de Inicio (MSF-361, flow alertas-inicio.yml). El flow llama cada 15 minutos a la Edge Function
# `recalcular-alertas-inicio`. Mismas reglas que los avisos de consultas: ALERTAS_INICIO_URL alcanzable desde
# el contenedor de Kestra; ALERTAS_INICIO_APIKEY es la clave pública (anon); SECRET_ALERTAS_INICIO_TOKEN va
# EN BASE64 y, decodificado, debe coincidir con ALERTAS_INICIO_TOKEN de los secretos de la función. El valor
# de ejemplo es «change-me-local». Valores reales solo en infra/kestra/.env.
ALERTAS_INICIO_URL=http://host.docker.internal:9300/functions/v1/recalcular-alertas-inicio
ALERTAS_INICIO_APIKEY=change-me-local
SECRET_ALERTAS_INICIO_TOKEN=Y2hhbmdlLW1lLWxvY2Fs

# Avisos de faltantes (MSF-405, flow avisos-faltantes.yml). El flow llama cada minuto a la Edge Function
# `enviar-aviso-faltante`. Mismas reglas que los avisos de consultas: AVISOS_FALTANTES_URL alcanzable desde
# el contenedor de Kestra; AVISOS_FALTANTES_APIKEY es la clave pública (anon); SECRET_AVISOS_FALTANTES_TOKEN
# va EN BASE64 y, decodificado, debe coincidir con AVISOS_FALTANTES_TOKEN de los secretos de la función.
# El valor de ejemplo es «change-me-local». Valores reales solo en infra/kestra/.env.
AVISOS_FALTANTES_URL=http://host.docker.internal:9300/functions/v1/enviar-aviso-faltante
AVISOS_FALTANTES_APIKEY=change-me-local
SECRET_AVISOS_FALTANTES_TOKEN=Y2hhbmdlLW1lLWxvY2Fs

# Presupuesto por correo (MSF-245, flow comprobantes-correo.yml). El flow baja el PDF del bucket privado
# `comprobantes-documentos` y lo envía con el SMTP de arriba (KESTRA_SMTP_*; KESTRA_SMTP_FROM es el
# remitente global). COMPROBANTES_STORAGE_URL: API de Supabase alcanzable desde el contenedor de Kestra.
# SECRET_COMPROBANTES_STORAGE_KEY: clave de servicio de Supabase EN BASE64 (printf '%s' '<clave>' | base64 -w0);
# el valor de ejemplo es «change-me-local». Valor real solo en infra/kestra/.env, nunca en Git.
COMPROBANTES_STORAGE_URL=http://host.docker.internal:9300
SECRET_COMPROBANTES_STORAGE_KEY=Y2hhbmdlLW1lLWxvY2Fs

# Correo masivo a clientes (MSF-370, flow correo-masivo.yml). Usa el SMTP de arriba (KESTRA_SMTP_*). El flow corre cada
# minuto y envía CORREO_MASIVO_LOTE correos por vez sin pasar de CORREO_MASIVO_LIMITE_DIARIO por organización y por día
# (lo que no entra retoma al día siguiente). CORREO_MASIVO_URL_BAJA es el origen público del panel, sin barra final:
# el pie de cada correo enlaza a <origen>/baja-correo/<token>. Valores reales solo en infra/kestra/.env.
CORREO_MASIVO_LOTE=50
CORREO_MASIVO_LIMITE_DIARIO=500
CORREO_MASIVO_URL_BAJA=http://localhost:5173
