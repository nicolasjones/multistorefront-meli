# Variables de GlitchTip (docker compose lee este .env junto al compose.yaml). Copiar a infra/glitchtip/.env.
# Nunca commitear el .env real. La contraseña y la SECRET_KEY son obligatorias (el Compose no arranca sin ellas):
# generá valores propios, p. ej. `openssl rand -hex 32`.
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_PORT=8100
