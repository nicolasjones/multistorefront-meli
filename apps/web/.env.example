# Vite no lee el .env de la raíz (solo apps/web/.env o apps/web/.env.local):
# si se cambia SUPABASE_API_PORT en el .env raíz, este valor se actualiza a
# mano acá (spec 015, contracts/variables-puerto.md).
VITE_SUPABASE_URL=http://127.0.0.1:9300
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
# El navegador solo usa la clave publicable. SMTP y claves administrativas se
# configuran fuera de Git en Supabase; nunca se agregan como variables VITE_.
# Nango self-hosted (spec 20260930-153545-conexiones-oauth-nango): el SDK de
# frontend abre el popup de consentimiento OAuth directo contra este host — no
# necesita ninguna clave secreta de Nango (NANGO_SECRET_KEY_* nunca se agrega
# como variable VITE_, solo la usa el backend/worker).
VITE_NANGO_PUBLIC_SERVER_URL=http://localhost:3005
