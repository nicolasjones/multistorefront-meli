{
  "name": "multistorefront-meli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm dev:refine",
    "dev:refine": "docker compose -f infra/refine/compose.yaml up -d --build",
    "dev:refine:host": "pnpm --filter @platform/web dev",
    "dev:supabase": "supabase start",
    "dev:kestra": "docker compose -f infra/kestra/compose.yaml up -d",
    "dev:superset": "docker compose -f infra/superset/compose.yaml up -d --build",
    "dev:playwright": "docker compose -f infra/playwright/compose.yaml up -d",
    "dev:runner": "docker compose --env-file .env -f infra/runner/compose.yaml up -d --build",
    "dev:nango": "docker compose -f infra/nango/compose.yaml up -d",
    "dev:mcp-server": "docker compose -f infra/mcp-server/compose.yaml up -d --build",
    "dev:down:refine": "docker compose -f infra/refine/compose.yaml down",
    "dev:down:supabase": "supabase stop --project-id multistorefront-meli-supabase-dev",
    "dev:down:kestra": "docker compose -f infra/kestra/compose.yaml down",
    "dev:down:superset": "docker compose -f infra/superset/compose.yaml down",
    "dev:down:playwright": "docker compose -f infra/playwright/compose.yaml down",
    "dev:down:runner": "docker compose --env-file .env -f infra/runner/compose.yaml down",
    "dev:down:nango": "docker compose -f infra/nango/compose.yaml down",
    "dev:down:mcp-server": "docker compose -f infra/mcp-server/compose.yaml down",
    "build": "pnpm --filter @platform/web build",
    "lint": "pnpm --filter @platform/web lint",
    "test": "pnpm test:auth:hook-bloqueo && pnpm test:kestra:copias && pnpm test:template:adoption && pnpm test:ia:sincronizar-edge-functions && pnpm test:prototipo:inventario && pnpm test:matriz:pantalla && pnpm test:web && pnpm test:ia && pnpm test:db",
    "ia:sincronizar-edge-functions": "node scripts/sincronizar-ia-edge-functions.mjs",
    "test:ia:sincronizar-edge-functions": "node --test scripts/sincronizar-ia-edge-functions.test.mjs",
    "test:edge:invitar-miembro": "node --test supabase/functions/invitar-miembro/handler.test.ts",
    "correo:verificar-salida": "node scripts/verificar-salida-correo.mjs",
    "test:edge:solicitar-acceso": "node --test supabase/functions/solicitar-acceso/handler.test.ts",
    "test:edge:crear-organizacion": "node --test supabase/functions/crear-organizacion/handler.test.ts",
    "test:edge:enviar-correo-proveedor": "node --test supabase/functions/enviar-correo-proveedor/handler.test.ts",
    "test:web": "pnpm --filter @platform/web test && pnpm test:edge:invitar-miembro && pnpm test:edge:solicitar-acceso && pnpm test:edge:crear-organizacion && pnpm test:edge:enviar-correo-proveedor",
    "test:e2e": "pnpm --filter @platform/web test:e2e",
    "test:auth:hook-bloqueo": "node --test scripts/verificar-hook-bloqueo.test.mjs",
    "test:auth:hook-bloqueo:e2e": "node --test scripts/verificar-hook-bloqueo.e2e.mjs",
    "test:acceso:e2e": "node --test scripts/e2e-acceso.e2e.mjs",
    "test:ia": "pnpm --filter @platform/ia --filter @platform/ia-navegacion --filter @platform/mcp-server test",
    "test:db": "supabase test db --local",
    "test:db:ci": "node scripts/supabase-ci.mjs verificar && PGPASSWORD=postgres PGSSLMODE=disable pg_prove --host host.docker.internal --port $SUPABASE_DB_PORT --username postgres --dbname postgres supabase/tests/database/*.sql",
    "db:reset:ci": "node scripts/reset-db-ci.mjs",
    "db:ci:preparar": "node scripts/supabase-ci.mjs preparar",
    "db:migrar:cloud": "node scripts/migrar-supabase-cloud.mjs",
    "test:db:migrar-cloud": "node --test scripts/migrar-supabase-cloud.test.mjs",
    "db:validar:aditivas": "node scripts/validar-migraciones-aditivas.mjs",
    "test:db:validar-aditivas": "node --test scripts/validar-migraciones-aditivas.test.mjs",
    "ci:verificar-staging-exitoso": "node scripts/verificar-staging-exitoso.mjs",
    "test:ci:verificar-staging-exitoso": "node --test scripts/verificar-staging-exitoso.test.mjs",
    "deploy:vps": "node scripts/deploy-vps.mjs",
    "test:deploy-vps": "node --test scripts/deploy-vps.test.mjs",
    "kestra:render-flow": "node infra/kestra/renderizar-flow.mjs",
    "kestra:sincronizar-rol-local": "node infra/kestra/sincronizar-rol-orquestacion.mjs",
    "kestra:deploy-flow": "node infra/kestra/desplegar-flow.mjs",
    "preview": "pnpm --filter @platform/web preview",
    "supabase": "supabase",
    "docs:schema": "node scripts/generar-doc-schema.mjs",
    "docs:check": "node scripts/verificar-documentacion-cambios.mjs",
    "estilos:check": "node scripts/verificar-estilos-sueltos.mjs",
    "test:estilos:sueltos": "node --test scripts/verificar-estilos-sueltos.test.mjs",
    "prototipo:inventario": "node scripts/prototipo-inventario.mjs",
    "prototipo:check": "node scripts/verificar-inventario-prototipo.mjs",
    "test:prototipo:inventario": "node --test scripts/verificar-inventario-prototipo.test.mjs",
    "matriz:check": "node scripts/verificar-matriz-pantalla.mjs",
    "test:matriz:pantalla": "node --test scripts/verificar-matriz-pantalla.test.mjs",
    "grafo:init": "graphify extract . --code-only --no-viz && graphify cluster-only . --no-label --no-viz && graphify hook install",
    "workers:discover": "node scripts/descubrir-workers.mjs --json",
    "test:workers:discover": "node --test scripts/descubrir-workers.test.mjs",
    "test:workers:egress": "node scripts/validar-egress-workers.mjs",
    "test:workers:scan": "node --test scripts/validar-scan-worker.test.mjs",
    "test:workers:idempotency": "node scripts/validar-idempotencia-workers.mjs",
    "test:workers:audit": "node scripts/validar-auditoria-workers.mjs",
    "test:superset:embebido": "node scripts/verificar-superset-embebido.mjs",
    "superset:importar-dashboards": "node infra/superset/importar-dashboards.mjs",
    "test:superset:importar-dashboards": "node --test infra/superset/importar-dashboards.test.mjs",
    "test:kestra:secretos": "node infra/kestra/test-secretos-orquestacion.mjs",
    "test:kestra:secretos:e2e": "node infra/kestra/validar-secretos-e2e.mjs",
    "test:kestra:runtime": "node infra/kestra/validar-workers-runtime.mjs",
    "test:kestra:evidencia": "node --test infra/kestra/validar-evidencia-flows.test.mjs",
    "test:kestra:evidencia:e2e": "node infra/kestra/validar-evidencia-e2e.mjs",
    "test:kestra:reintentos": "node --test infra/kestra/validar-reintentos-flows.test.mjs",
    "test:kestra:copias": "node --test infra/kestra/validar-copias-flows.test.mjs",
    "test:kestra:reintentos:e2e": "node infra/kestra/validar-reintentos-e2e.mjs",
    "test:kestra:conexion-trabada:e2e": "node infra/kestra/validar-conexion-trabada-e2e.mjs",
    "test:kestra:despachador-programado": "node --test infra/kestra/validar-despachador-programado.test.mjs",
    "test:ia:aprovisionamiento": "node --test infra/ia/aprovisionar-proveedores.test.mjs",
    "test:tooling": "node --test scripts/operaciones.test.mjs scripts/supabase-ci.test.mjs",
    "test:kestra:deploy-flow": "node --test infra/kestra/desplegar-flow.test.mjs infra/kestra/sincronizar-rol-orquestacion.test.mjs",
    "test:outbox:frontera": "node scripts/verificar-frontera-outbox.mjs",
    "template:capabilities:check": "node scripts/verificar-versiones-capacidades.mjs",
    "infra:config": "pnpm infra:config:refine && pnpm infra:config:kestra && pnpm infra:config:superset && pnpm infra:config:playwright && pnpm infra:config:runner && pnpm infra:config:nango && pnpm infra:config:mcp-server",
    "infra:config:refine": "docker compose -f infra/refine/compose.yaml config --quiet",
    "infra:config:kestra": "docker compose -f infra/kestra/compose.yaml config --quiet",
    "infra:config:superset": "docker compose -f infra/superset/compose.yaml config --quiet",
    "infra:config:playwright": "docker compose -f infra/playwright/compose.yaml config --quiet",
    "infra:config:runner": "docker compose -f infra/runner/compose.yaml config --quiet",
    "infra:config:nango": "docker compose -f infra/nango/compose.yaml config --quiet",
    "infra:config:mcp-server": "docker compose -f infra/mcp-server/compose.yaml config --quiet",
    "test:template:adoption": "node --test scripts/verificar-versiones-capacidades.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.61.0",
    "supabase": "^2.57.2"
  }
}
