# Local infrastructure only. Copy to .env and change values before exposing it.
# Docker Compose lee el .env desde la carpeta del propio compose.yaml, no
# desde la raíz: copiá este archivo también a infra/<producto>/.env (p. ej.
# infra/kestra/.env, infra/superset/.env) para que las variables se apliquen.
# Puertos de desarrollo local (spec 015) — cada default es el puerto que el
# template usa hoy: copiar este archivo sin cambiar nada arranca igual que
# antes de esta feature. Para correr el template y un producto derivado en
# paralelo en la misma máquina, cambiar solo estos valores (más la excepción
# documentada de supabase/config.toml, que no admite variables en campos de
# puerto). Ver specs/015-puertos-configurables/contracts/variables-puerto.md
# para qué archivo consume cada una.
WEB_PORT=4300
SUPABASE_API_PORT=9300
SUPABASE_DB_PORT=7634
SUPABASE_DB_SHADOW_PORT=7633
SUPABASE_POOLER_PORT=57329
SUPABASE_STUDIO_PORT=4301
SUPABASE_MAILPIT_PORT=4302
SUPABASE_EDGE_INSPECTOR_PORT=8084
SUPABASE_ANALYTICS_PORT=57327
KESTRA_PORT=8085
SUPERSET_PORT=8089
PLAYWRIGHT_PORT=4303
NANGO_PORT=3005
MCP_SERVER_PORT=8788
# KESTRA_BASIC_AUTH_USERNAME/PASSWORD y KESTRA_PUBLIC_URL también viven como
# secrets de los GitHub Environments publicar-flows-kestra-staging/-production
# (spec 20261003-105444-cicd-staging-produccion) — valor real distinto por
# entorno, nunca el de este archivo.
KESTRA_BASIC_AUTH_USERNAME=admin@local.test
KESTRA_BASIC_AUTH_PASSWORD=ChangeMe1Local
KESTRA_DB_PASSWORD=change-me-local
KESTRA_PUBLIC_URL=https://kestra.example.com
# Contraseña del rol kestra_backups (spec 011) — mínimo privilegio, solo
# EXECUTE sobre las 3 funciones de respaldo. Se rota por entorno con
# "alter role kestra_backups with password '...'" (research.md R8); la
# migración solo crea el rol con un placeholder, nunca este valor real.
KESTRA_BACKUPS_DB_PASSWORD=change-me-local
# URL JDBC que usan las 3 tareas de public.iniciar_respaldo /
# finalizar_respaldo_completado / finalizar_respaldo_error (spec 011,
# research.md R4) — conexión con el rol kestra_backups, sin privilegio
# más allá de esas 3 funciones. En desarrollo local apunta al mismo
# host:puerto fijo que ya usa pnpm test:db:ci; en staging/producción se
# reemplaza por la cadena propia de ese entorno, solo en su
# infra/kestra/.env (nunca en Git).
KESTRA_BACKUPS_DB_URL=jdbc:postgresql://host.docker.internal:7634/postgres
# Cadena de conexión que usa `pg_dump` en sí (spec 011, research.md
# R3/R4) — necesita leer todas las tablas, algo que kestra_backups
# nunca tiene (research.md R1/R2), así que no reutiliza esa credencial.
# En desarrollo local ya apunta a las credenciales fijas del CLI de
# Supabase (mismo patrón que pnpm test:db:ci); en staging/producción se
# reemplaza por la cadena propia de ese entorno, solo en su
# infra/kestra/.env.
KESTRA_BACKUPS_PGDUMP_URL=postgres://postgres:postgres@host.docker.internal:7634/postgres
# Contraseña del rol kestra_orquestacion (spec 013) — mínimo privilegio,
# EXECUTE acotado a las funciones SECURITY DEFINER de orquestación
# multi-organización. Mismo patrón que KESTRA_BACKUPS_DB_PASSWORD (spec
# 011); no crece con cada organización nueva (FR-008): es un único rol
# para todo Kestra.
KESTRA_ORQUESTACION_DB_PASSWORD=change-me-local
# URL JDBC que usan las tareas de infra/kestra/flows/plantilla-generico.yml
# / plantilla-dedicado.yml (spec 013, research.md R2) — conexión con el rol
# kestra_orquestacion, sin privilegio más allá de sus funciones. Mismo
# host:puerto fijo de desarrollo local por default que KESTRA_BACKUPS_DB_URL;
# en staging/producción se reemplaza por la cadena propia de ese entorno,
# solo en su infra/kestra/.env (nunca en Git).
KESTRA_ORQUESTACION_DB_URL=jdbc:postgresql://host.docker.internal:7634/postgres
# Clave privada de orquestación SSH (spec 014), codificada en Base64. Dejar
# vacía en este archivo; configurar el valor real solamente en
# infra/kestra/.env o en el gestor de secretos del entorno. Sin prefijo
# ENV_: secret() de Kestra lee directo las variables de proceso con prefijo
# SECRET_, a diferencia de envs.* que sí lo necesita.
SECRET_ORQUESTACION_SSH_PRIVATE_KEY=
# Tope de organizaciones que un flow generico puede despachar en paralelo
# (spec 013, research.md R6). Diez evita saturar Kestra, la base o los VPS;
# cada entorno puede ajustarlo segun su capacidad sin versionar su .env.
KESTRA_ORQUESTACION_CONCURRENCIA=10
# Evidencia visual de workers de navegador (spec 20260925-133820). false por
# defecto: habilitarla por entorno solo cuando se necesite diagnosticar. Las
# capturas se publican como outputs de Kestra y la limpieza programada las
# borra al superar EVIDENCIA_RETENCION_DIAS. EVIDENCIA_DIR_HOST es la base
# transitoria en cada host de despacho; debe existir y ser del usuario SSH.
EVIDENCIA_VISUAL=false
EVIDENCIA_RETENCION_DIAS=30
EVIDENCIA_DIR_HOST=/var/lib/automation-platform/evidencia
# Router HTTP centralizado de las alertas de orquestacion (spec 013). Debe
# recibir tipo, organizacion_id, conexion_id, motivo y destinatarios; enruta
# las tecnicas al operador y las de credencial tambien a los administradores
# de la organizacion. Configurar el valor real solo en infra/kestra/.env.
KESTRA_ALERTAS_WEBHOOK_URL=http://localhost:8098/alertas
SUPERSET_SECRET_KEY=change-me-local-with-at-least-42-characters
SUPERSET_DB_PASSWORD=change-me-local
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-local
SUPERSET_ADMIN_EMAIL=admin@local.test
# Firma los guest tokens de la analítica embebida (spec 007) — distinto de
# SUPERSET_SECRET_KEY a propósito.
SUPERSET_GUEST_TOKEN_JWT_SECRET=change-me-local-with-at-least-42-characters
# Cuenta de servicio dedicada que usa emitir-acceso-reporte para pedir
# guest tokens (spec 007) — infra/superset/crear_cuenta_servicio_guest_token.py
# la crea en el arranque con el único permiso que necesita
# (can_grant_guest_token), nunca la cuenta interactiva SUPERSET_ADMIN_*.
# Mismos nombres que supabase/functions/.env.example: mismo valor, dos
# mecanismos de despliegue distintos (Compose acá, secrets de Edge
# Functions allá).
SUPERSET_GUEST_TOKEN_USERNAME=guest-token-service
SUPERSET_GUEST_TOKEN_PASSWORD=change-me-local
# Origen del front de Refine, para el CORS de Superset (spec 007). También
# se agrega a allow_domain_list de cada embed en cada superset-init
# (configurar_embebido.py), junto con localhost/127.0.0.1:WEB_PORT.
REFINE_ORIGIN=http://localhost:4300
# Red Docker que crea `supabase start` (supabase_network_<project_id>). Superset
# se une con alias `superset` para que emitir-acceso-reporte lo alcance.
SUPABASE_DOCKER_NETWORK=supabase_network_multistorefront-meli-supabase-dev
# Token con permiso "repo" para que infra/runner registre/desregistre el
# self-hosted runner solo. Nunca commitear el valor real, solo este ejemplo.
GH_RUNNER_PAT=ghp_change-me-local
# Runner self-hosted (infra/runner, spec 20260925-221701). Todas opcionales;
# ver docs/deployment.md para cuándo ajustarlas. Recrear los runners corta los
# jobs en curso: verificar antes que ninguno esté busy.
RUNNER_REPLICAS=3
RUNNER_MEMORY_LIMIT=3g
RUNNER_PNPM_NETWORK_CONCURRENCY=16
# Mismo nombre en varios productos = un único store de pnpm en la máquina.
RUNNER_PNPM_STORE_VOLUME=platform-runner-pnpm-store

# Nango self-hosted (spec 20260930-153545-conexiones-oauth-nango) — motor de
# autenticación OAuth de plataforma, nunca credenciales de negocio de una
# organización (eso sigue siendo SUPABASE_VAULT vía public.conexiones, spec
# 013). Cifra las credenciales de proveedor que guarda en su propia base
# (nango-db); cambiar en cualquier entorno compartido.
NANGO_ENCRYPTION_KEY=ybH2At/IUEgUmWW9GMI9PIZbrgQXbuZO97zJShOJElg=
NANGO_DB_PASSWORD=nango-local
NANGO_DASHBOARD_USERNAME=admin@local.test
NANGO_DASHBOARD_PASSWORD=ChangeMe1Local
# Callback HTTPS de OAuth: en desarrollo local, http://localhost funciona;
# en staging/producción debe ser el dominio propio que cada producto
# derivado ya opera detrás de su reverse proxy — la plantilla no lo provee
# (research.md R5 de la spec de conexiones OAuth).
NANGO_SERVER_URL=http://localhost:3005
NANGO_PUBLIC_SERVER_URL=http://localhost:3005
# Secreto de plataforma para autenticar contra la API HTTP de Nango
# (Authorization: Bearer) desde el backend/worker de un producto derivado —
# nunca desde Supabase ni desde el navegador
# (contracts/obtener-token-oauth.md). Uno por entorno; rotar solo en
# infra/nango/.env o el gestor de secretos del entorno, nunca acá. Debe ser
# un UUID v4 (la API de Nango lo valida).
NANGO_SECRET_KEY_DEV=01df8743-e924-4364-8e5e-952170af0721

# Aprovisionamiento de claves de IA (spec 016). Estas variables sólo se leen
# una vez por infra/ia/aprovisionar-proveedores.mjs para guardar o rotar la
# clave en Vault. No cargarlas en Refine, Kestra ni en el entorno de un worker
# ya ejecutando; usar un archivo local ignorado o el gestor de secretos del
# despliegue. IA_PROVEEDOR_CLAVE debe quedar vacía en todo archivo versionado.
IA_PROVEEDOR_CODIGO=
IA_PROVEEDOR_CREDENCIAL=
IA_PROVEEDOR_CLAVE=

# Supabase Auth en produccion: configurar SMTP externo y sus credenciales en
# el gestor de secretos o Dashboard de Supabase. No incorporar esas credenciales
# ni claves service-role en archivos .env versionados.

# CI/CD staging -> producción (spec 20261003-105444-cicd-staging-produccion).
# Estas claves NO viven en este archivo con un valor real: se configuran como
# GitHub Actions secrets, uno por GitHub Environment (staging y producción,
# por separado, por mecanismo) — ver docs/adoptar-cicd-staging-produccion.md.
# Cadena de conexión Postgres del proyecto Supabase cloud de ese entorno.
# Usada por scripts/migrar-supabase-cloud.mjs vía `supabase db push
# --db-url`. Deliberadamente no es un access token de cuenta (que podría
# administrar todos los proyectos): acotada a la base de ese proyecto.
SUPABASE_DB_URL=
# Clave SSH privada en texto plano PEM (sin Base64 — los secrets de GitHub
# Actions ya soportan multilínea) para que el job de CI controle el Docker
# del VPS de ese entorno vía `DOCKER_HOST=ssh://...`. Usuario y host del VPS de
# ese entorno acompañan por separado. scripts/deploy-vps.mjs no cambia de
# código, solo cómo el runner alcanza el Docker remoto.
VPS_SSH_PRIVATE_KEY=
VPS_SSH_USER=
VPS_SSH_HOST=
# Bloque completo de variables que hoy viven en .env.<entorno> en el
# filesystem del VPS (Kestra, Superset, Nango, Playwright) — el workflow lo
# escribe como archivo .env.<entorno> transitorio en el workspace del job,
# nunca persiste en el VPS ni se commitea.
VPS_DEPLOY_ENV=
# Credenciales de la API de Superset para infra/superset/importar-dashboards.mjs
# (import de dashboards versionados + registro de reportes, FR-009). Una cuenta de
# servicio de Superset con permiso de import, por entorno.
SUPERSET_URL=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=

# Host de la base de la app que usa la conexión de solo lectura de Superset
# (rol `superset_analitica`, FR-008) al empaquetar los YAML, y su contraseña.
# Sin valor real en Git: se inyectan por entorno.
SUPERSET_ANALITICA_DB_HOST=
SUPERSET_ANALITICA_DB_PASSWORD=
# Registro automático de reportes durante el import (server-side, nunca en el
# navegador): URL de la API de Supabase, service-role key y UUID de un usuario
# existente que queda como `creado_por` en public.reportes. Si faltan, el import
# igual importa los dashboards y avisa que no registró reportes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPERSET_REPORTE_CREADO_POR=
# Copias de seguridad (épica MSF-457, F-OPS-01). Destino: remoto rclone
# `respaldos` = directorio dedicado del MISMO servidor (decisión 2026-10-17).
# RESPALDOS_DIR_HOST es la carpeta del host (idealmente un disco o punto de
# montaje propio, fuera de los volúmenes de Supabase, permisos 700 para el
# usuario que corre Kestra); dentro de los contenedores de copia se ve en
# /respaldos (RESPALDOS_RUTA). Para llevar las copias a S3/B2/SFTP se cambian
# solo estas variables (RESPALDOS_RCLONE_TIPO=s3|b2|sftp + credenciales y
# RESPALDOS_RUTA=bucket/prefijo); los flows no cambian. Ver
# docs/copias-y-restauracion.md. Valores reales solo en infra/kestra/.env.
RESPALDOS_DIR_HOST=/var/lib/automation-platform/respaldos
RESPALDOS_RUTA=/respaldos
RESPALDOS_RCLONE_TIPO=local
# Solo para tipos remotos (s3/b2/sftp); vacías con tipo local.
RESPALDOS_RCLONE_PROVIDER=
RESPALDOS_RCLONE_ENDPOINT=
RESPALDOS_RCLONE_REGION=
RESPALDOS_RCLONE_ACCESS_KEY_ID=
RESPALDOS_RCLONE_SECRET_ACCESS_KEY=
RESPALDOS_RCLONE_HOST=
RESPALDOS_RCLONE_USER=
RESPALDOS_RCLONE_PASS=
# Retención: copias diarias recientes y primera copia de cada mes (FR-003).
RESPALDOS_RETENCION_DIARIAS=30
RESPALDOS_RETENCION_MENSUALES=12
# Tablas (esquema.tabla, separadas por coma) que deben tener datos tras la
# restauración de prueba (FR-004).
RESPALDOS_VERIFICAR_TABLAS=public.respaldos,public.organizaciones
# Endpoint S3 de Supabase Storage y sus claves de acceso S3 (generadas en el
# Storage de Supabase). Origen de la copia de imágenes.
RESPALDOS_STORAGE_ENDPOINT=http://host.docker.internal:9300/storage/v1/s3
RESPALDOS_STORAGE_REGION=local
RESPALDOS_STORAGE_ACCESS_KEY_ID=change-me-local
RESPALDOS_STORAGE_SECRET_ACCESS_KEY=change-me-local
# Aviso de fallos de copia/verificación por correo (FR-005): SMTP genérico,
# el proveedor concreto se elige después. KESTRA_SMTP_TRANSPORTE: SMTP,
# SMTPS o SMTP_TLS.
KESTRA_SMTP_HOST=smtp.example.com
KESTRA_SMTP_PORT=587
KESTRA_SMTP_TRANSPORTE=SMTP_TLS
KESTRA_SMTP_USERNAME=
KESTRA_SMTP_PASSWORD=
KESTRA_SMTP_FROM=copias@example.com
SOPORTE_CORREO=soporte@example.com
