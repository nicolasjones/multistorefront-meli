{
  "openapi": "3.1.0",
  "info": {
    "title": "API pública de la plataforma",
    "version": "v1",
    "description": "Lectura de catálogo, stock, precios y ventas de la organización de la clave. La organización sale SIEMPRE de la clave: ningún parámetro la cambia. Los cambios aditivos no rompen v1; un cambio incompatible exige v2 (D-4)."
  },
  "servers": [
    {
      "url": "/api-v1",
      "description": "Edge Function api-v1: la ruta de la API es lo que va después del prefijo."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/productos": {
      "get": {
        "summary": "Catálogo de la organización",
        "description": "Requiere el alcance `productos`. Máximo 100 filas por página (por defecto 50).",
        "operationId": "listarProductos",
        "tags": [
          "lectura"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limite"
          },
          {
            "$ref": "#/components/parameters/ActualizadoDesde"
          }
        ],
        "responses": {
          "200": {
            "description": "Página del catálogo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaProductos"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ParametroInvalido"
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "403": {
            "$ref": "#/components/responses/AlcanceInsuficiente"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/v1/stock": {
      "get": {
        "summary": "Stock por producto y depósito",
        "description": "Requiere el alcance `stock`. Máximo 100 filas por página (por defecto 50).",
        "operationId": "listarStock",
        "tags": [
          "lectura"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limite"
          },
          {
            "$ref": "#/components/parameters/ActualizadoDesde"
          }
        ],
        "responses": {
          "200": {
            "description": "Página del stock.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaStock"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ParametroInvalido"
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "403": {
            "$ref": "#/components/responses/AlcanceInsuficiente"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/v1/precios": {
      "get": {
        "summary": "Precios de lista y escalas",
        "description": "Requiere el alcance `precios`. No calcula precio final por empresa ni IVA.",
        "operationId": "listarPrecios",
        "tags": [
          "lectura"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limite"
          },
          {
            "$ref": "#/components/parameters/ActualizadoDesde"
          }
        ],
        "responses": {
          "200": {
            "description": "Página de precios.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaPrecios"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ParametroInvalido"
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "403": {
            "$ref": "#/components/responses/AlcanceInsuficiente"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/v1/ventas": {
      "get": {
        "summary": "Facturas confirmadas",
        "description": "Requiere el alcance `ventas`. Solo facturas (`tipo = factura`) confirmadas; no expone cliente ni contacto.",
        "operationId": "listarVentas",
        "tags": [
          "lectura"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limite"
          },
          {
            "$ref": "#/components/parameters/ActualizadoDesde"
          }
        ],
        "responses": {
          "200": {
            "description": "Página de ventas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaVentas"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ParametroInvalido"
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "403": {
            "$ref": "#/components/responses/AlcanceInsuficiente"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "Contrato de la API",
        "description": "Se sirve sin clave: el contrato es público por definición.",
        "operationId": "obtenerContrato",
        "tags": [
          "contrato"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Este documento.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MetodoNoSoportado"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Clave de API de la organización (`msf_<prefijo>_<secreto>`)."
      }
    },
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Cursor opaco de la página anterior. Un cursor inválido responde `400 cursor_invalido`.",
        "schema": {
          "type": "string"
        }
      },
      "Limite": {
        "name": "limite",
        "in": "query",
        "required": false,
        "description": "Filas por página: de 1 a 100 (por defecto 50).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "ActualizadoDesde": {
        "name": "actualizado_desde",
        "in": "query",
        "required": false,
        "description": "ISO-8601 con zona. Trae solo lo actualizado desde ese instante (inclusive).",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "codigo",
              "mensaje"
            ],
            "properties": {
              "codigo": {
                "type": "string",
                "enum": [
                  "token_ausente",
                  "token_invalido",
                  "clave_vencida",
                  "clave_revocada",
                  "alcance_insuficiente",
                  "limite_excedido",
                  "cursor_invalido",
                  "parametro_invalido",
                  "no_encontrado",
                  "metodo_no_soportado",
                  "error_interno"
                ]
              },
              "mensaje": {
                "type": "string"
              }
            }
          }
        }
      },
      "Producto": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "sku",
          "activo",
          "moneda",
          "precio_lista",
          "actualizado_en"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "activo": {
            "type": "boolean"
          },
          "categoria_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "categoria": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ruta «Padre > Hija» de la categoría."
          },
          "moneda": {
            "type": "string"
          },
          "precio_lista": {
            "type": "number"
          },
          "actualizado_en": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Stock": {
        "type": "object",
        "required": [
          "producto_id",
          "nombre",
          "sku",
          "deposito_id",
          "deposito",
          "cantidad",
          "reservado",
          "disponible",
          "actualizado_en"
        ],
        "properties": {
          "producto_id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "deposito_id": {
            "type": "string",
            "format": "uuid"
          },
          "deposito": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "reservado": {
            "type": "number"
          },
          "disponible": {
            "type": "number"
          },
          "actualizado_en": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Precios": {
        "type": "object",
        "required": [
          "producto_id",
          "nombre",
          "sku",
          "moneda",
          "precio_lista",
          "actualizado_en"
        ],
        "properties": {
          "producto_id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "moneda": {
            "type": "string"
          },
          "precio_lista": {
            "type": "number"
          },
          "precio_x5": {
            "type": [
              "number",
              "null"
            ]
          },
          "precio_x10": {
            "type": [
              "number",
              "null"
            ]
          },
          "precio_x50": {
            "type": [
              "number",
              "null"
            ]
          },
          "actualizado_en": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Venta": {
        "type": "object",
        "required": [
          "id",
          "numero",
          "fecha",
          "total_sin_iva",
          "total_con_iva",
          "estado",
          "confirmado_en"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "numero": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "empresa_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "total_sin_iva": {
            "type": "number"
          },
          "total_con_iva": {
            "type": "number"
          },
          "estado": {
            "type": "string"
          },
          "confirmado_en": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ListaProductos": {
        "type": "object",
        "required": [
          "datos",
          "siguiente_cursor"
        ],
        "properties": {
          "datos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Producto"
            }
          },
          "siguiente_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ListaStock": {
        "type": "object",
        "required": [
          "datos",
          "siguiente_cursor"
        ],
        "properties": {
          "datos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stock"
            }
          },
          "siguiente_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ListaPrecios": {
        "type": "object",
        "required": [
          "datos",
          "siguiente_cursor"
        ],
        "properties": {
          "datos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Precios"
            }
          },
          "siguiente_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ListaVentas": {
        "type": "object",
        "required": [
          "datos",
          "siguiente_cursor"
        ],
        "properties": {
          "datos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Venta"
            }
          },
          "siguiente_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "responses": {
      "ParametroInvalido": {
        "description": "Un parámetro de la consulta no es válido (cursor inválido incluido).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NoAutorizado": {
        "description": "Falta la clave, no es válida, o está revocada o vencida.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "AlcanceInsuficiente": {
        "description": "La clave no tiene el alcance que pide la ruta.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "LimiteExcedido": {
        "description": "Se superó el límite de uso de la clave. La cabecera `Retry-After` dice en cuántos segundos reintentar.",
        "headers": {
          "Retry-After": {
            "description": "Segundos a esperar antes de reintentar.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MetodoNoSoportado": {
        "description": "La API es de solo lectura.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ErrorInterno": {
        "description": "No se pudo completar la llamada.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "x-versions-retiradas": {}
}
